# Leave both unset to run entirely on bundled sample data (lib/sampleData.ts) -
# the app is fully functional with zero config for local dev / a first deploy.

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Project Settings -> API -> service_role key (NOT the anon key - this is
# server-side only, used in Route Handlers, never sent to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: powers the "Run live scrape" button (app/api/rescrape) ---
# Without these three, the button shows "not configured yet" instead of
# erroring — the rest of the dashboard works fine without them.

# Fine-grained GitHub Personal Access Token, scoped to this one repo, with
# "Actions: read and write" permission. Settings -> Developer settings ->
# Fine-grained tokens, on GitHub. Server-side only — never sent to the browser.
GITHUB_TOKEN=

# "your-username/your-repo"
GITHUB_REPO=

# Defaults to scrape.yml if unset — only set this if you rename the
# workflow file under .github/workflows/.
GITHUB_WORKFLOW_FILE=

# Defaults to "main" if unset — the branch the workflow runs against.
GITHUB_REF=
